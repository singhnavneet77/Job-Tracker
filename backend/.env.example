# Copy this file to .env (or set these as real environment variables /
# "Secrets" in your host's dashboard). None are required to run locally —
# sane dev defaults are baked in — but set real values before sharing a
# public URL with testers.

# Signing key for JWTs. MUST be changed for any deployment beyond your
# own machine — anyone who knows the default can forge tokens.
JWT_SECRET=change-this-to-a-long-random-string

# Database connection.
#   - Leave unset to use local SQLite (./job_tracker.db) — fine for your
#     own machine, but most free hosts (including Hugging Face Spaces)
#     wipe local disk on every redeploy, so applications/profiles will
#     reset each time you push an update.
#   - For anything you're sharing with testers, point this at a free
#     Postgres instance instead (Neon, Supabase, Railway all have a
#     no-credit-card free tier):
# DATABASE_URL=postgresql://user:password@host/dbname

# Comma-separated list of allowed frontend origins for CORS. Leave unset
# (defaults to "*") while testing; lock it down once you know your
# frontend's real deployed URL:
# CORS_ORIGINS=https://your-frontend.vercel.app
